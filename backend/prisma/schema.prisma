generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  admin
  checker
  client
}

enum TicketStatus {
  reserved
  paid
  pending_confirmation
  confirmed
  used
  cancelled
  expired
}

enum PaymentStatus {
  pending // en proceso
  completed // éxito normal o recuperado
  failed // fallo del proveedor de pago
  refunded // reembolso por parte de admin
  expired // webhook del provvedor no notifica en N minutos
  completed_unfulfillable // webhook notifica tarde y ya no hay entradas disponibles, pendiente de reembolso
}

enum PolicyType {
  privacy_policy
  terms_of_service
}

enum TicketTypeStatus {
  enabled
  disabled
  blocked
}

model User {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cedula      String?   @unique @db.VarChar(20)
  fullName    String    @map("full_name") @db.VarChar(150)
  address     String?   @db.Text
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  email       String    @unique @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  role        UserRole
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  egresado    Boolean   @default(false) @map("egresado")

  privacyAcceptances PrivacyAcceptance[]
  tickets            Ticket[]
  payments           Payment[]
  createdPayments    Payment[]           @relation("CreatedPayments")
  checkedInTickets   Ticket[]            @relation("CheckedInBy")

  @@index([createdAt])
  @@map("users")
}

model EgresadosList {
  cedula String @unique @db.VarChar(20)

  @@map("egresados_list")
}

model PolicyVersion {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyType  PolicyType @map("policy_type")
  version     String     @db.VarChar(20)
  content     String     @db.Text
  contentHash String     @map("content_hash") @db.VarChar(64)
  publishedAt DateTime   @default(now()) @map("published_at") @db.Timestamptz

  acceptances PrivacyAcceptance[]

  @@unique([policyType, version])
  @@index([policyType, publishedAt])
  @@map("policy_versions")
}

model PrivacyAcceptance {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  policyVersionId String        @map("policy_version_id") @db.Uuid
  acceptedAt      DateTime      @default(now()) @map("accepted_at") @db.Timestamptz
  ipAddress       String        @map("ip_address") @db.Inet
  userAgent       String        @map("user_agent")
  user            User          @relation(fields: [userId], references: [id])
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id])

  @@unique([userId, policyVersionId])
  @@index([userId])
  @@map("privacy_acceptances")
}

model TicketType {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String           @db.VarChar(100)
  description   String?
  priceCents    Int              @map("price_cents")
  quantityTotal Int              @map("quantity_total")
  quantitySold  Int              @default(0) @map("quantity_sold")
  maxPerUser    Int?             @map("max_per_user")
  saleEndsAt    DateTime?        @map("sale_ends_at") @db.Timestamptz
  status        TicketTypeStatus @default(enabled) @map("status")
  onlyEgresados Boolean          @default(false) @map("only_egresados")
  zona          String?          @map("zona") @db.VarChar(20)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tickets Ticket[]

  @@index([zona])
  @@map("ticket_types")
}

model Ticket {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketTypeId            String       @map("ticket_type_id") @db.Uuid
  userId                  String       @map("user_id") @db.Uuid
  paymentId               String?      @map("payment_id") @db.Uuid
  unitPriceCents          Int          @map("unit_price_cents")
  ticketCode              String       @unique @map("ticket_code") @db.VarChar(100)
  qrToken                 String?      @unique @map("qr_token") @db.Text
  status                  TicketStatus
  reserveExpiresAt        DateTime?    @map("reserve_expires_at") @db.Timestamptz
  purchasedAt             DateTime?    @map("purchased_at") @db.Timestamptz
  cancelledAt             DateTime?    @map("cancelled_at") @db.Timestamptz
  confirmationRequestedAt DateTime?    @map("confirmation_requested_at") @db.Timestamptz
  checkedInAt             DateTime?    @map("checked_in_at") @db.Timestamptz
  checkedInBy             String?      @map("checked_in_by") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz

  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  checker    User?      @relation("CheckedInBy", fields: [checkedInBy], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([userId])
  @@index([ticketTypeId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
  @@index([status, reserveExpiresAt], map: "idx_tickets_reserved_expiry") //  no soporta índices parciales nativamente
  @@map("tickets")
}

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       String        @db.VarChar(50)
  providerTxId   String?       @map("provider_tx_id") @db.VarChar(255)
  subtotalCents  Int           @map("subtotal_cents")
  totalCents     Int           @map("total_cents")
  status         PaymentStatus @default(pending)
  createdBy      String?       @map("created_by") @db.Uuid
  metadata       Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id])
  creator      User?         @relation("CreatedPayments", fields: [createdBy], references: [id])
  tickets      Ticket[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("payments")
}

enum DonationStatus {
  pending
  confirmed
  rejected
  cancelled
}

enum DonationAccount {
  LA_CONVENCION
  BARRANQUEROS_UTP
  VICTIMAS
}

model Donation {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name         String?         @map("full_name") @db.VarChar(150)
  email             String?         @db.VarChar(255)
  company           String?         @map("company") @db.VarChar(150)
  amountCents       Int             @map("amount_cents")
  state             DonationStatus  @default(pending) @map("state")
  account           DonationAccount @map("account")
  externalReference String          @unique @map("external_reference") @db.VarChar(100)
  paymentId         String?         @map("payment_id") @db.VarChar(255)
  metadata          Json?           @map("metadata")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([state, account])
  @@map("donations")
}

model DonationCounter {
  id           Int       @id @default(1)
  currentValue Int       @default(0) @map("current_value")
  metaValue    Int       @default(0) @map("meta_value")
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy    String?   @map("updated_by") @db.Uuid

  @@map("donation_counter")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String
  actorId     String
  actorRole   String
  actorName   String?
  actorCedula String?  @db.VarChar(20)
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@index([eventId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}
